# Local development
VITE_API_URL=http://localhost:8001/api

# Production: set this in the Vercel project's Environment Variables
# (Settings -> Environment Variables), NOT by editing this file -- Vite
# bakes VITE_* vars in at build time, so a change here does nothing for an
# already-deployed site. Use the same Render backend URL as the other
# portals, with the /api suffix:
# VITE_API_URL=https://sterpnew-1.onrender.com/api
#
# After setting/changing this in Vercel, you must trigger a new deployment
# (redeploy) for it to take effect -- it is not picked up live.
